}

[application]

config/name="g-scaffold"
run/main_scene="res://src/game/scenes/launcher/launcher.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Bus="*res://src/framework/autoloads/bus.gd"
App="*res://src/framework/autoloads/app.gd"
Game="*res://src/game/autoloads/game.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/GodotGoogleSignIn/plugin.cfg", "res://addons/SharePlugin/plugin.cfg", "res://addons/admob/plugin.cfg", "res://addons/apple_sign_in/plugin.cfg", "res://addons/godot-iap/plugin.cfg", "res://addons/godotx_att/plugin.cfg", "res://addons/godotx_firebase/plugin.cfg", "res://addons/locate_in_filesystem/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
