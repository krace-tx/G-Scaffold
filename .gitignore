# ============================================================
#  Godot 4+
# ============================================================
# 编辑器缓存与导入产物(每次 import 自动重建,禁止入库)
.godot/

# 注意:以下必须【入库】,不要忽略——
#   *.import  资源导入参数(他人拉取后才能正确导入资源)
#   *.uid     Godot 4.4+ 资源唯一标识
#   docs/.gdignore  让编辑器忽略 docs/,这是源文件

# C# / Mono 构建产物(本项目为 GDScript,预留以防误建)
.mono/
data_*/

# ============================================================
#  Android / iOS 构建模板与产物
# ============================================================
/android/
/ios/.build/
/addons/**/bin/
# Windows GDExtension stub manifests (bin/ is otherwise ignored for native mobile binaries).
!/addons/**/bin/*.gdextension
!/addons/**/bin/*.gdextension.uid

# ============================================================
#  导出与构建输出
# ============================================================
/build/
/export/
/dist/
*.exe
*.pck
*.apk
*.aab
*.ipa
*.dmg
*.zip

# ============================================================
#  密钥与签名材料(绝不入库)
# ============================================================
# export_presets.cfg 会保存 keystore 密码等敏感字段,默认忽略。
# 若团队需要共享导出配置,自行从下方移除并确保其中不含明文密码。
export_presets.cfg
*.keystore
*.jks
*.p12
*.pepk
*.mobileprovision
*.cer

# ============================================================
#  编辑器/用户本地覆盖
# ============================================================
override.cfg

# ============================================================
#  操作系统 / IDE 噪声
# ============================================================
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.tmp
*~

# Godot 4+ specific ignores
.godot/
/android/
*.apk
.idea/
/iOS-Export-Dev
/iOS-Export-Prod
/ios
*.aab
/Test
*.TMP

